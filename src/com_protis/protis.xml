<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
	<name>com_protis</name>
	<author>Francesco Impallari (CNR-IBF)</author>
	<creationDate>2026-11</creationDate>
	<copyright>(C) CNR - Istituto di Biofisica</copyright>
	<license>EUPL-1.2 - vedi LICENSE</license>
	<authorUrl>https://github.com/frimpa/protis_ibf</authorUrl>
	<version>3.27.0</version>
	<description>COM_PROTIS_XML_DESCRIPTION</description>
	<namespace path="src">Cnr\Component\Protis</namespace>
	<scriptfile>script.php</scriptfile>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install/mysql/install.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall/mysql/uninstall.sql</file>
		</sql>
	</uninstall>
	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>

	<files folder="site">
		<folder>guide</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages folder="site">
		<language tag="it-IT">language/it-IT/com_protis.ini</language>
		<language tag="en-GB">language/en-GB/com_protis.ini</language>
	</languages>

	<media destination="com_protis" folder="media">
		<filename>joomla.asset.json</filename>
		<folder>css</folder>
		<folder>js</folder>
		<folder>images</folder>
	</media>

	<administration>
		<menu img="class:clock">COM_PROTIS</menu>
		<submenu>
			<menu link="option=com_protis&amp;view=dashboard">COM_PROTIS_MENU_DASHBOARD</menu>
		</submenu>
		<files folder="administrator">
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<filename>composer.json</filename>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
			<folder>vendor</folder>
		</files>
		<languages folder="administrator">
			<language tag="it-IT">language/it-IT/com_protis.ini</language>
			<language tag="it-IT">language/it-IT/com_protis.sys.ini</language>
			<language tag="en-GB">language/en-GB/com_protis.ini</language>
			<language tag="en-GB">language/en-GB/com_protis.sys.ini</language>
		</languages>
	</administration>
</extension>
